{
  "name": "firebird-contractor-matching",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/core/*.test.ts tests/ui/*.test.ts tests/server/*.test.ts",
    "data:prepare": "node --import tsx scripts/prepare-data.ts",
    "data:check": "node --import tsx scripts/prepare-data.ts --check",
    "demo": "node --import tsx scripts/demo.ts",
    "demo:generate": "node --import tsx scripts/generate-demos.ts",
    "check:browser": "node --import tsx scripts/check-browser-build.ts",
    "check": "npm run data:check && npm run typecheck && npm test && npm run check:browser"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "csv-parse": "7.0.2",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
